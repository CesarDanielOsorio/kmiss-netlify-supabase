PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitalis
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h
NODE_ENV=development

# Netlify: usar la URI Transaction pooler (6543) con ?sslmode=verify-full.
# Para inicializar el esquema usar Session pooler (5432), fuera del build.
# Si el certificado lo requiere, configurar PGSSLROOTCERT con la CA de Supabase.
# DATABASE_URL nunca se comparte con React ni se sube a GitHub.

# Local conserva BYTEA; en Netlify configurar IMAGE_STORAGE=supabase.
IMAGE_STORAGE=postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kmiss-media

# Solo para ejecutar seed en una base NUEVA, nunca durante el build.
DEMO_PASSWORD=
